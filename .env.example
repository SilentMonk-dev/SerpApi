# ==============================================================================
# Incredible India Travel & Trust Platform (Yatra One) - Environment Configuration
# Copy this file to .env or .env.local and configure your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI & LLM PROVIDERS
# ------------------------------------------------------------------------------
# Google Gemini API Key: Powers Sahayak AI travel assistant and itinerary generation
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=""

# Groq API Key: High-speed LLM engine for travel intelligence & route planning fallback
# Get your key at: https://console.groq.com/
GROQ_API_KEY=""

# ------------------------------------------------------------------------------
# 2. SEARCH & EXTERNAL DATA APIS
# ------------------------------------------------------------------------------
# SerpApi Key: Real-time Google Search, Knowledge Graph, and local place results
# Get your key at: https://serpapi.com/
SERPAPI_API_KEY=""

# Weather API Key: Real-time weather overlay and destination forecasts
# Get your key at: https://www.weatherapi.com/
WEATHER_API_KEY=""

# ------------------------------------------------------------------------------
# 3. GOOGLE MAPS CONFIGURATION
# ------------------------------------------------------------------------------
# Google Maps API Key: Interactive maps, satellite imagery, directions, and geocoding
# Client-side (Vite) key:
VITE_GOOGLE_MAPS_API_KEY=""
# Server-side / fallback key:
GOOGLE_MAPS_API_KEY=""
